# Local-only MVP. Start script reads this file via python-dotenv; Vite reads VITE_*.
BACKEND_PORT=8017
FRONTEND_PORT=5177
# Optional absolute database path; default is data/tourism.sqlite3
# DATABASE_PATH=/absolute/path/to/tourism.sqlite3
# Optional AMap JS API browser key (public browser credential; restrict allowed domains)
AMAP_JS_KEY=
# Server-only security code. Configure via scripts/configure_amap_js.py
AMAP_JS_SECURITY_CODE=
# Optional backend Web Service credential; separate from the Web/JS credential above.
# Safe local input: .venv/bin/python scripts/configure_amap_key.py
# Merely configuring this does NOT enable a production provider.
# Probe: .venv/bin/python scripts/evaluate_amap_capabilities.py --live --request-cap 20
AMAP_WEB_SERVICE_KEY=
# Development only; blank uses same-origin /api proxy
VITE_API_BASE=
# Alibaba Cloud Model Studio, server-side only (Beijing key by default)
DASHSCOPE_API_KEY=
# Optional: use the matching regional/workspace endpoint ending in /api/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Optional OpenAI-compatible language service; question workflow works without it.
# Configure all three explicitly. No automatic paid provider is enabled.
# Kimi: https://api.moonshot.cn/v1 + kimi-k2.6 (non-thinking JSON extraction).
# Keep the real key only in .env or the backend process environment, never VITE_*.
TOURISM_LLM_BASE_URL=
TOURISM_LLM_API_KEY=
TOURISM_LLM_MODEL=
# M7: HTTPS production must enable Secure cookies; localhost HTTP is the dev exception.
M7_COOKIE_SECURE=false
# Keep this ledger on a protected location OUTSIDE main-DB backup rollbacks.
# Missing or mismatched ledger blocks memory reads. Never replace it with an old backup.
# M7_DELETION_LEDGER_PATH=/absolute/path/to/current-deletion-ledger.sqlite3
# Default: 60 new guest sessions per minute per local-process IP bucket.
M7_SESSION_RATE_LIMIT=60

# POI lookup only; both explicit gates required. Never enables a formal traffic provider.
AMAP_LOCATION_SEARCH_ENABLED=0
AMAP_TERMS_REVIEWED=0
AMAP_LOCATION_POI_API_VERSION=v5

# Read-only reference route queries; never enables the formal planning traffic provider.
AMAP_REFERENCE_ROUTES_ENABLED=0
