              "type": "null"
            }
          ]
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "route_version": {
          "minimum": 0,
          "title": "Route Version",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "readiness": {
          "additionalProperties": true,
          "title": "Readiness",
          "type": "object"
        }
      },
      "required": [
        "id",
        "schema_version",
        "status",
        "draft",
        "anchor",
        "version",
        "route_version",
        "updated_at",
        "readiness"
      ],
      "title": "CityStateV2",
      "type": "object"
    },
