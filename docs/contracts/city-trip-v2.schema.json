{
  "$defs": {
    "CityDraft": {
      "additionalProperties": false,
      "properties": {
        "business_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Date"
        },
        "starts_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starts At"
        },
        "ends_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ends At"
        },
        "origin_place_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Place Id"
        },
        "destination_place_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Place Id"
        },
        "interests": {
          "default": [],
          "items": {
            "enum": [
              "show",
              "photo",
              "food",
              "culture"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Interests",
          "type": "array"
        },
        "dish_interest_ids": {
          "default": [],
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Dish Interest Ids",
          "type": "array"
        },
        "modes": {
          "default": [
            "walking"
          ],
          "items": {
            "enum": [
              "walking",
              "driving",
              "transit"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "pace": {
          "default": "standard",
          "enum": [
            "relaxed",
            "standard",
            "compact"
          ],
          "title": "Pace",
          "type": "string"
        },
        "objective": {
          "default": "balanced",
          "enum": [
            "balanced",
            "less_walking",
            "less_waiting",
            "lower_cost"
          ],
          "title": "Objective",
          "type": "string"
        },
        "stops": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Stop"
          },
          "maxItems": 24,
          "title": "Stops",
          "type": "array"
        }
      },
      "title": "CityDraft",
      "type": "object"
    },
    "CityDraftV2": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Shanghai",
          "default": "Asia/Shanghai",
