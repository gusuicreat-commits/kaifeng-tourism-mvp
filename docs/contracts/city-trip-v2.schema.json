          "type": "string"
        },
        "day_count": {
          "maximum": 3,
          "minimum": 1,
          "title": "Day Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "city-draft/2",
          "title": "Schema Version",
          "type": "string"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/DayDraft"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Days",
          "type": "array"
        },
        "overnights": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Overnight"
          },
          "maxItems": 2,
          "title": "Overnights",
          "type": "array"
        }
      },
      "required": [
        "start_date",
        "end_date",
        "schema_version",
        "days"
      ],
      "title": "CityDraftV2",
      "type": "object"
    },
    "CityStateV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
