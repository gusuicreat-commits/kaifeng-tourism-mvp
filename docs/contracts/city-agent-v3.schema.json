{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "query查;search_dining餐饮;search_services服务;modify改已排路线;preference偏好;cancel只撤销待确认修改;progress进度;position位置。出发前不去/候补/改优先级不是action，填planning.choices。",
          "enum": [
            "query",
            "search_dining",
            "search_services",
            "modify",
            "preference",
            "cancel",
            "progress",
            "position"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "target_name": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "具体菜/店/地名/节目；泛指null。",
          "title": "Target Name"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "trip",
                "next",
                "shows",
                "dining",
                "travel",
                "history",
                "reference"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "普通query给purpose=trip/next/shows/dining/travel/history/reference。trip=行程;next=下一站;shows=演出;dining=餐饮;travel=交通;history=历史;reference=引用。",
          "title": "Purpose"
        },
        "near": {
          "default": false,
          "description": "true=附近；false=不限。",
          "title": "Near",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "quote"
      ],
      "title": "Action",
      "type": "object"
    },
    "AdvanceTask": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "expected_step": {
          "maximum": 12,
          "minimum": 0,
          "title": "Expected Step",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "expected_step"
      ],
      "title": "AdvanceTask",
      "type": "object"
    },
    "BasketCandidate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "对象类型：scenic=景区;food=菜品;place=地点;poi=兴趣点;show=演出;vendor=商家;program=节目。",
          "enum": [
            "scenic",
            "food",
            "place",
            "poi",
            "show",
            "vendor",
            "program"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        }
      },
      "required": [
        "kind",
        "object_id",
        "name"
      ],
      "title": "BasketCandidate",
      "type": "object"
    },
    "BasketChoicePrompt": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "priority": {
          "description": "优先级：must=明确非去不可；want=一般想去，未表态默认；optional=有空或顺路再去。",
          "enum": [
            "must",
            "want",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        },
        "operation": {
          "default": "put",
          "description": "put=加入或改优先级;standby=候补。",
          "enum": [
            "put",
            "standby"
          ],
          "title": "Operation",
          "type": "string"
        },
        "priority_stated": {
          "default": true,
          "title": "Priority Stated",
          "type": "boolean"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/BasketCandidate"
          },
          "maxItems": 40,
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "query",
        "quote",
        "priority",
        "candidates"
      ],
      "title": "BasketChoicePrompt",
      "type": "object"
    },
    "BasketProposal": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/BasketProposalItem"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "basket_version": {
          "minimum": 0,
          "title": "Basket Version",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "basket_version"
      ],
      "title": "BasketProposal",
      "type": "object"
    },
    "BasketProposalItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "对象类型：scenic=景区;food=菜品;place=地点;poi=兴趣点;show=演出;vendor=商家;program=节目。",
          "enum": [
            "scenic",
            "food",
            "place",
            "poi",
            "show",
            "vendor",
            "program"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "operation": {
          "description": "put=加入;standby=候补。",
          "enum": [
            "put",
            "standby"
          ],
          "title": "Operation",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "priority": {
          "description": "优先级：must=明确非去不可；want=一般想去，未表态默认；optional=有空或顺路再去。",
          "enum": [
            "must",
            "want",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_id",
        "operation",
        "name",
        "priority",
        "quote"
      ],
      "title": "BasketProposalItem",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_tools": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "Max Tools",
          "type": "integer"
        },
        "max_model_calls": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_seconds": {
          "default": 45,
          "maximum": 240,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "number"
        },
        "max_repairs": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "food=菜;preserve_shows=保演出;walking_seconds=步行上限;return_by=返回;meal_at=用餐;visit_at=活动;objective=目标;pace=节奏。",
          "enum": [
            "food",
            "preserve_shows",
            "walking_seconds",
            "return_by",
            "meal_at",
            "visit_at",
            "objective",
            "pace"
          ],
          "title": "Field",
          "type": "string"
        },
        "strength": {
          "description": "hard=必须;soft=尽量;optional=可放弃;unknown=不明。",
          "enum": [
            "hard",
            "soft",
            "optional",
            "unknown"
          ],
          "title": "Strength",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "field",
        "strength",
        "quote"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Conversation": {
      "additionalProperties": false,
      "properties": {
        "reply": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Reply",
          "type": "string"
        }
      },
      "required": [
        "reply"
      ],
      "title": "Conversation",
      "type": "object"
    },
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "maxLength": 200,
          "title": "Before",
          "type": "string"
        },
        "after": {
          "description": "口语纠正取最后有效值。",
          "maxLength": 200,
          "title": "After",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after",
        "quote"
      ],
      "title": "Correction",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "description": "下一步工具：search_dining=查餐饮；query_shows=查演出；verify_travel=核交通衔接；preview_plan=预览行程；search_locations=查地点；query_reference_route=查参考路线；finish=结束；clarify=请求澄清。",
          "enum": [
            "search_dining",
            "query_shows",
            "verify_travel",
            "preview_plan",
            "search_locations",
            "query_reference_route",
            "finish",
            "clarify"
          ],
          "title": "Tool",
          "type": "string"
        },
        "place_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "其他动作留空。",
          "title": "Place Id"
        },
        "relax_optional_food": {
          "default": false,
          "description": "仅当餐饮要求全为可放弃条件且服务器允许时设为 true。",
          "title": "Relax Optional Food",
          "type": "boolean"
        }
      },
      "required": [
        "tool"
      ],
      "title": "Decision",
      "type": "object"
    },
    "MaterialChoice": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "priority": {
          "description": "priority：must=游客明确表示非去不可，want=一般想去（默认），optional=有空/顺路再去，没有明确表态时用want，不放宽必选。想去/去趟/顺路/看看=want或optional；必须/一定/非去不可=must。",
          "enum": [
            "must",
            "want",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "description": "pending=候选;standby=候补。",
          "enum": [
            "pending",
            "standby"
          ],
          "title": "Status",
          "type": "string"
        },
        "quote": {
          "description": "choices含素材全名/priority/status；quote含整段意愿/优先级/不去，仅地名不填。",
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "priority_stated": {
          "default": false,
          "description": "明确优先级才true；仅true改已有项；不去/候补用choices。",
          "title": "Priority Stated",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "priority",
        "quote"
      ],
      "title": "MaterialChoice",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "scenic",
            "food",
            "place",
            "poi",
            "show",
            "vendor",
            "program"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PlanningField": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "city城市;date日期;start_time/end_time起止;origin/destination出发/返回;pace节奏;objective目标;mode交通;budget_fen预算分;trip_days天。",
          "enum": [
            "city",
            "date",
            "start_time",
            "end_time",
            "origin",
            "destination",
            "pace",
            "objective",
            "mode",
            "budget_fen",
            "trip_days"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "日期抄原文；晚间沿用到后续钟点（今晚五点半…十点回→17:30、22:00），无钟点不猜，几点前回来用end_time。pace=relaxed放松/standard标准/compact紧凑;objective=balanced均衡/less_walking少走路/less_waiting少等待/lower_cost省钱;少走路/走不动/腿脚不便=less_walking;无分钟不填walking_seconds。",
          "title": "Value"
        },
        "quote": {
          "description": "quote连续摘本轮，field.quote含value；往返复用origin.quote。",
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "budget_basis": {
          "anyOf": [
            {
              "enum": [
                "total",
                "per_person"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "trip_days填整数，“两三天”取上限；budget_fen同时给budget_basis（total总预算/per_person每人预算），由你判断口径，系统会把理解结果告诉游客。分：300元=30000；每人金额不乘人数。",
          "title": "Budget Basis"
        }
      },
      "required": [
        "field",
        "value",
        "quote"
      ],
      "title": "PlanningField",
      "type": "object"
    },
    "PlanningIntent": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "default": "update",
          "description": "update=改条件;weather_replan=天气调整。“就这样/开始安排”用continue，fields/choices空。",
          "enum": [
            "update",
            "continue",
            "weather_replan"
          ],
          "title": "Operation",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanningField"
          },
          "maxItems": 12,
          "title": "Fields",
          "type": "array"
        },
        "choices": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MaterialChoice"
          },
          "maxItems": 12,
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "quote"
      ],
      "title": "PlanningIntent",
      "type": "object"
    },
    "ReferenceRouteIntent": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "destination": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "use_current_position": {
          "default": false,
          "title": "Use Current Position",
          "type": "boolean"
        },
        "mode": {
          "default": "walking",
          "description": "walking=步行;driving=驾车;transit=公交。",
          "enum": [
            "walking",
            "driving",
            "transit"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "quote",
        "destination"
      ],
      "title": "ReferenceRouteIntent",
      "type": "object"
    },
    "ReferenceSelection": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "expected_step": {
          "maximum": 12,
          "minimum": 0,
          "title": "Expected Step",
          "type": "integer"
        },
        "role": {
          "description": "origin=起点;destination=终点。",
          "enum": [
            "origin",
            "destination"
          ],
          "title": "Role",
          "type": "string"
        },
        "resolution_id": {
          "format": "uuid",
          "title": "Resolution Id",
          "type": "string"
        },
        "candidate_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "expected_step",
        "role",
        "resolution_id",
        "candidate_id"
      ],
      "title": "ReferenceSelection",
      "type": "object"
    },
    "ServiceField": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "check_in=入住;check_out=退房;nights=晚;guests=人;rooms=房;max_price=每晚上限;stay_budget_fen=住宿总分;location_text=位置;room_type=房型;window=窗;external_window=外窗;dry_wet=干湿;breakfast=早餐;free_parking=停车;clean=干净;quiet=安静。",
          "enum": [
            "check_in",
            "check_out",
            "nights",
            "guests",
            "rooms",
            "max_price",
            "stay_budget_fen",
            "location_text",
            "room_type",
            "window",
            "external_window",
            "dry_wet",
            "breakfast",
            "free_parking",
            "clean",
            "quiet"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "入住/退房date value抄原文；nights按晚数独立保存；room_type、location_text抄原词，标间不能推人数/间数。max_price为每晚元；stay_budget_fen为住宿合计分，不能混成整趟预算或报价；金额口径由你判断。",
          "title": "Value"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "strength": {
          "default": "hard",
          "description": "设施/房间条件、真假与强弱由你判断，strength填hard/soft/optional；系统会把理解结果告诉游客。hard=必须；soft=尽量；optional=可放弃。",
          "enum": [
            "hard",
            "soft",
            "optional"
          ],
          "title": "Strength",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "quote"
      ],
      "title": "ServiceField",
      "type": "object"
    },
    "ServiceIntent": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "category": {
          "default": "hotels",
          "description": "hotels=酒店；parking=停车；merchants=商家。",
          "enum": [
            "hotels",
            "parking",
            "merchants"
          ],
          "title": "Category",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ServiceField"
          },
          "maxItems": 16,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "quote"
      ],
      "title": "ServiceIntent",
      "type": "object"
    },
    "StartTask": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "expected_route_version": {
